# =============================================
# SmartTraffic Zero Trust — Variables de entorno
# IPs PRIVADAS de cada VM (no cambian al reiniciar)
# =============================================

# Auth Server (vm-auth)
AUTH_SERVER_URL=http://172.31.43.93:5000/login
JWT_SECRET=super-secret-key

# Kafka (vm-data)
KAFKA_BROKER=172.31.45.191:9092

# RabbitMQ (vm-data)
RABBITMQ_HOST=172.31.45.191
RABBITMQ_PORT=5672

# Credenciales RabbitMQ — admin
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASS=password123

# Credenciales RabbitMQ — por servicio
RABBITMQ_USER_SENSOR=sensor
RABBITMQ_PASS_SENSOR=password_sensor

RABBITMQ_USER_PROCESSOR=processor
RABBITMQ_PASS_PROCESSOR=password_processor

RABBITMQ_USER_APP=app_user
RABBITMQ_PASS_APP=password_app

# IPs privadas de las VMs (referencia)
VM_AUTH_IP=172.31.43.93
VM_DATA_IP=172.31.45.191
VM_INGEST_IP=172.31.46.69
VM_CORE_IP=172.31.46.43
VM_APP_IP=172.31.39.177