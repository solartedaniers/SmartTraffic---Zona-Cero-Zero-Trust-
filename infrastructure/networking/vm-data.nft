sudo tee /etc/nftables.conf << 'EOF'
#!/usr/sbin/nft -f

flush ruleset

table inet filter {
    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        tcp dport 22 accept

        # Kafka desde vm-ingest (IP nueva)
        ip saddr 172.31.46.69 tcp dport 9092 accept

        # Kafka desde vm-processor
        ip saddr 172.31.46.43 tcp dport 9092 accept

        # RabbitMQ desde vm-processor y vm-app
        ip saddr 172.31.46.43 tcp dport 5672 accept
        ip saddr 172.31.39.177 tcp dport 5672 accept

        # Consola RabbitMQ
        tcp dport 15672 accept

        # Ping
        icmp type echo-request accept
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }
}
EOF

sudo nft -f /etc/nftables.conf
sudo systemctl restart nftables
